{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "workspaces": {
        ".": {
            "entry": [
                "*.config.ts",
                "test/**/*.test.ts",
                "test/*.mjs",
                "test/types.ts",
                "test/fixtures/**/*.{ts,vue}",
                "test/client-types.ts",
                "test/config-types.ts",
                "test/ai-client-types.ts",
                "test/ai-actions-types.ts",
                "test/seo-types.ts"
            ],
            "project": ["*.ts", "test/**/*.{ts,mjs,vue}"],
            "ignoreDependencies": ["@takumi-rs/core", "@vue/compiler-sfc", "tailwindcss"],
            "ignore": ["test/fixtures/**/.nuxt/**", "test/fixtures/**/.wrangler/**"]
        },
        "packages/site-admin": {
            "entry": [
                "src/{index,adapter,ai,client,cli,form,generate,nuxt}.ts!",
                "src/runtime/*.ts!",
                "src/server/index.ts!",
                "src/nuxt/server.ts!",
                "src/adapters/drizzle.ts!",
                "src/devtools/{index,dock,client/app}.ts!",
                "src/runtime/tasks/*.ts!",
                "src/ai/operations.ts!",
                "src/dependency-aliases.ts!",
                "src/seo.ts!"
            ],
            "project": ["src/**/*.ts!", "*.config.ts"],
            "ignoreDependencies": [
                "@nuxtjs/i18n",
                "@nuxtjs/robots",
                "@nuxtjs/sitemap",
                "nuxt-og-image",
                "nuxt-schema-org",
                "nuxt-seo-utils"
            ],
            "ignoreIssues": {
                "package.json": ["optionalPeerDependencies"]
            }
        }
    }
}
