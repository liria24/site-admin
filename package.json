{
    "name": "site-admin-workspace",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "bun --filter @liria24/site-admin build",
        "check": "bun run format:check && bun run lint && bun run workspace:check && bun run unused && bun run typecheck && bun run test && bun run build && bun run test:nuxt && bun run test:cloudflare && bun run package:check && bun run test:packed",
        "deps:update": "taze",
        "format": "vp fmt . --write",
        "format:check": "vp fmt . --check",
        "lint": "vp lint .",
        "lint:fix": "vp lint . --fix",
        "unused": "knip && knip --production",
        "workspace:check": "sherif",
        "preview:package": "pkg-pr-new publish ./packages/site-admin --bun --no-compact --previewVersion --comment=update",
        "package:check": "publint packages/site-admin && attw --pack packages/site-admin --profile esm-only",
        "test": "vp test run",
        "test:cloudflare": "node test/cloudflare-local.mjs && node test/native-stream.mjs cloudflare && node test/nuxt-d1.mjs",
        "test:nuxt": "vp test run --config vitest.nuxt.config.ts && node test/nuxt-build.mjs && node test/native-stream.mjs node",
        "test:packed": "node test/packed-consumers.mjs",
        "typecheck": "bun --filter @liria24/site-admin typecheck && tsc --noEmit -p test/tsconfig.json"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@better-auth/drizzle-adapter": "^1.7.7",
        "@liria24/site-admin": "workspace:*",
        "@nuxt/test-utils": "4.3.3",
        "@nuxtjs/better-auth": "^0.3.7",
        "@nuxtjs/i18n": "^10.6.0",
        "@takumi-rs/core": "^2.14.0",
        "@tanstack/vue-form": "2.0.0-alpha.2",
        "@types/node": "^26.6.4",
        "@vue/compiler-sfc": "3.6.0-rc.9",
        "ai": "^7.0.0",
        "better-auth": "^1.7.7",
        "cf": "1.0.0-beta.12",
        "comark": "^0.7.0",
        "db0": "^0.4.1",
        "drizzle-kit": "1.0.0-rc.4",
        "drizzle-orm": "1.0.0-rc.4",
        "files-sdk": "^2.6.2",
        "h3": "^1.15.11",
        "jiti": "^2.7.0",
        "knip": "6.39.0",
        "nitropack": "2.13.4",
        "nuxt": "4.6.0",
        "nuxt-files-sdk": "^0.2.0",
        "pkg-pr-new": "0.0.90",
        "publint": "^0.3.25",
        "sherif": "1.13.0",
        "tailwindcss": "^4.3.3",
        "taze": "^21.3.0",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
        "vite-plus": "1.1.0",
        "vitest": "5.0.3",
        "vue": "3.6.0-rc.9",
        "wrangler": "^4.147.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
        "vitest": "5.0.3"
    },
    "engines": {
        "node": "^24.11.0 || >=26.0.0"
    },
    "packageManager": "bun@1.4.2",
    "patchedDependencies": {
        "nuxt@4.6.0": "patches/nuxt@4.6.0.patch"
    }
}
