{
    "name": "site-admin-workspace",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "bun --filter @liria24/site-admin build",
        "check": "bun run format:check && bun run lint && bun run workspace:check && bun run unused && bun run typecheck && bun run test && bun run build && bun run test:nuxt && bun run test:cloudflare && bun run package:check && bun run test:packed",
        "deps:update": "taze",
        "format": "oxfmt . --write",
        "format:check": "oxfmt . --check",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "unused": "knip && knip --production",
        "workspace:check": "sherif",
        "preview:package": "pkg-pr-new publish ./packages/site-admin --bun --no-compact --previewVersion --comment=update",
        "package:check": "publint packages/site-admin && attw --pack packages/site-admin --profile esm-only",
        "test": "vitest run",
        "test:cloudflare": "node test/cloudflare-local.mjs",
        "test:nuxt": "vitest run --config vitest.nuxt.config.ts && node test/nuxt-build.mjs",
        "test:packed": "node test/packed-consumers.mjs",
        "typecheck": "bun --filter @liria24/site-admin typecheck && tsc --noEmit -p test/tsconfig.json"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@better-auth/drizzle-adapter": "^1.7.6",
        "@liria24/site-admin": "workspace:*",
        "@nuxt/kit": "^4.5.2",
        "@nuxt/test-utils": "4.3.2",
        "@nuxtjs/better-auth": "^0.3.6",
        "@nuxtjs/i18n": "^10.6.0",
        "@takumi-rs/core": "^2.14.0",
        "@tanstack/vue-form": "2.0.0-alpha.2",
        "@types/node": "^26.6.3",
        "@vue/compiler-sfc": "3.6.0-rc.9",
        "better-auth": "^1.7.6",
        "cf": "1.0.0-beta.7",
        "comark": "^0.7.0",
        "db0": "^0.4.1",
        "drizzle-orm": "1.0.0-rc.4",
        "files-sdk": "^2.6.2",
        "h3": "^1.15.11",
        "jiti": "^2.7.0",
        "knip": "6.38.0",
        "nitropack": "2.13.4",
        "nuxt": "4.5.2",
        "nuxt-files-sdk": "^0.1.1",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "7.0.2003",
        "pkg-pr-new": "0.0.88",
        "publint": "^0.3.24",
        "sherif": "1.13.0",
        "tailwindcss": "^4.3.3",
        "taze": "^21.2.0",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.2",
        "vue": "3.6.0-rc.9",
        "wrangler": "^4.143.1"
    },
    "engines": {
        "node": "^24.11.0 || >=26.0.0"
    },
    "packageManager": "bun@1.4.2"
}
