{
    "name": "@liria24/site-admin",
    "version": "0.0.2",
    "description": "Runtime-first, schema-driven site administration for Nuxt",
    "homepage": "https://github.com/liria24/site-admin#readme",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liria24/site-admin.git",
        "directory": "packages/site-admin"
    },
    "bin": {
        "site-admin": "./dist/cli.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./adapter": {
            "types": "./dist/adapter.d.ts",
            "import": "./dist/adapter.js"
        },
        "./generate": {
            "types": "./dist/generate.d.ts",
            "import": "./dist/generate.js"
        },
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./ai": {
            "types": "./dist/ai.d.ts",
            "import": "./dist/ai.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js"
        },
        "./form": {
            "types": "./dist/form.d.ts",
            "import": "./dist/form.js"
        },
        "./nuxt": {
            "types": "./dist/nuxt.d.ts",
            "import": "./dist/nuxt.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./runtime/public-handler": "./dist/runtime/public-handler.js",
        "./runtime/management-handler": "./dist/runtime/management-handler.js",
        "./runtime/devtools-snapshot": "./dist/runtime/devtools-snapshot.js",
        "./package.json": "./package.json",
        "./module.json": "./dist/module.json",
        "./adapters/drizzle": {
            "types": "./dist/adapters/drizzle.d.ts",
            "import": "./dist/adapters/drizzle.js"
        },
        "./nuxt/server": {
            "types": "./dist/nuxt/server.d.ts",
            "import": "./dist/nuxt/server.js"
        },
        "./runtime/nitro2": "./dist/runtime/nitro2.js",
        "./runtime/tasks": {
            "types": "./dist/runtime/tasks.d.ts",
            "import": "./dist/runtime/tasks.js"
        },
        "./runtime/tasks/publish-due": {
            "types": "./dist/runtime/tasks/publish-due.d.ts",
            "import": "./dist/runtime/tasks/publish-due.js"
        },
        "./runtime/tasks/asset-gc": {
            "types": "./dist/runtime/tasks/asset-gc.d.ts",
            "import": "./dist/runtime/tasks/asset-gc.js"
        },
        "./runtime/tasks/sync-assets": {
            "types": "./dist/runtime/tasks/sync-assets.d.ts",
            "import": "./dist/runtime/tasks/sync-assets.js"
        },
        "./runtime/database": {
            "types": "./dist/runtime/database.d.ts",
            "import": "./dist/runtime/database.js"
        },
        "./config-resolution": {
            "types": "./dist/config-resolution.d.ts",
            "import": "./dist/config-resolution.js"
        },
        "./dependency-aliases": {
            "types": "./dist/dependency-aliases.d.ts",
            "import": "./dist/dependency-aliases.js"
        },
        "./seo": {
            "types": "./dist/seo.d.ts",
            "import": "./dist/seo.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "prepack": "bun run build",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@nuxt/devtools-kit": "4.0.0-beta.3",
        "@nuxt/kit": "^4.6.0",
        "@nuxt/schema": "^4.6.0",
        "@nuxtjs/better-auth": "^0.3.7",
        "@nuxtjs/i18n": "^10.6.0",
        "@nuxtjs/robots": "^6.2.4",
        "@nuxtjs/sitemap": "^8.6.1",
        "@standard-schema/spec": "^1.1.0",
        "ai": "^7.0.0",
        "better-auth": "^1.7.7",
        "comark": "^0.7.0",
        "comark-content": "^0.4.1",
        "devframe": "1.2.1",
        "exsolve": "^1.1.3",
        "files-sdk": "^2.6.2",
        "h3": "^1.15.11",
        "jiti": "^2.7.0",
        "nitropack": "2.13.4",
        "nuxt-files-sdk": "^0.1.1",
        "nuxt-llms": "^0.2.0",
        "nuxt-og-image": "^6.10.3",
        "nuxt-schema-org": "^6.4.3",
        "nuxt-seo-utils": "^8.6.1",
        "rou3": "^1.0.0"
    },
    "peerDependencies": {
        "@better-auth/drizzle-adapter": "^1.7.7",
        "@tanstack/vue-form": "2.0.0-alpha.2",
        "drizzle-kit": "1.0.0-rc.4",
        "drizzle-orm": "1.0.0-rc.4",
        "nuxt": "^4.6.0",
        "vue": "^3.6.0-rc.2"
    },
    "peerDependenciesMeta": {
        "@better-auth/drizzle-adapter": {
            "optional": true
        },
        "@tanstack/vue-form": {
            "optional": true
        },
        "drizzle-kit": {
            "optional": true
        },
        "drizzle-orm": {
            "optional": true
        },
        "nuxt": {
            "optional": true
        },
        "vue": {
            "optional": true
        }
    },
    "engines": {
        "node": "^24.11.0 || >=26.0.0"
    }
}
