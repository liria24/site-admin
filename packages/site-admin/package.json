        },
        "./internal/runtime/seo": {
            "types": "./dist/runtime/seo.d.ts",
            "import": "./dist/runtime/seo.js"
        },
        "./internal/schema": {
            "types": "./dist/schema.d.ts",
            "import": "./dist/schema.js",
            "require": "./dist/schema.js"
        }
    },
